# Qwen Codex local OpenAI-compatible base URL.
QWEN_CODEX_BASE_URL=http://127.0.0.1:8002/v1

# API key used for bearer auth. Local vLLM accepts a placeholder unless API key auth is configured.
QWEN_CODEX_API_KEY=local-dev-key

# Served model name reported by the local vLLM server.
QWEN_CODEX_MODEL=qwen35-local

# Context window used by Qwen Codex and expected from /v1/models.
QWEN_CODEX_CONTEXT_WINDOW=32768

# Request and stream idle timeout in milliseconds.
QWEN_CODEX_REQUEST_TIMEOUT_MS=120000

# Default log level passed to the Codex child process when RUST_LOG is unset.
QWEN_CODEX_LOG_LEVEL=info

# vLLM reasoning parser used by the local Qwen server.
QWEN_CODEX_REASONING_PARSER=qwen3

# vLLM tool-call parser used by the local Qwen server.
QWEN_CODEX_TOOL_CALL_PARSER=qwen3_coder

# Whether vLLM should use automatic tool choice. Use true or false.
QWEN_CODEX_AUTO_TOOL_CHOICE=true

# OpenAI-compatible base URL for the YOLO refiner model.
QWEN_CODEX_YOLO_REFINER_BASE_URL=http://127.0.0.1:8002/v1

# API key for the YOLO refiner endpoint.
QWEN_CODEX_YOLO_REFINER_API_KEY=local-dev-key

# Model name for the YOLO refiner endpoint.
QWEN_CODEX_YOLO_REFINER_MODEL=qwen35-local

# Directory where YOLO run logs will be written.
QWEN_CODEX_YOLO_LOG_DIR=.qwen-codex/yolo-runs

# Maximum seconds one YOLO agent round may run before YOLO stops cleanly.
QWEN_CODEX_YOLO_ROUND_TIMEOUT_SECS=600

# Maximum files the YOLO refiner should ask the agent to modify in one round.
QWEN_CODEX_YOLO_ROUND_GOAL_MAX_FILES=8

# Maximum concrete actions the YOLO refiner should ask for in one round.
QWEN_CODEX_YOLO_ROUND_GOAL_MAX_ACTIONS=5

# Maximum verification commands the YOLO refiner should ask for in one round.
QWEN_CODEX_YOLO_ROUND_GOAL_MAX_TESTS=3

# Maximum characters accepted for a refiner-generated next prompt.
QWEN_CODEX_YOLO_REFINER_MAX_PROMPT_CHARS=3000

# Refiner planning style. The default favors small incremental product steps.
QWEN_CODEX_YOLO_REFINER_STYLE=incremental

# Continue after an agent-round timeout by asking for a smaller retry prompt.
# Defaults to false because stopping is safer for unattended local runs.
QWEN_CODEX_YOLO_CONTINUE_AFTER_TIMEOUT=false

# Default YOLO iteration limit. Leave blank for unlimited unless a CLI limit is provided.
QWEN_CODEX_YOLO_DEFAULT_ITERATIONS=

# Maximum repeated refiner prompts before YOLO mode stops.
QWEN_CODEX_YOLO_MAX_REPEATED_PROMPTS=3

# Maximum consecutive failures before YOLO mode stops.
QWEN_CODEX_YOLO_MAX_FAILURES=3

# Legacy alias for QWEN_CODEX_BASE_URL.
# QWEN_BASE_URL=http://127.0.0.1:8002/v1

# Legacy alias for QWEN_CODEX_API_KEY.
# QWEN_API_KEY=local-dev-key

# Legacy alias for QWEN_CODEX_MODEL.
# QWEN_MODEL_NAME=qwen35-local

# Legacy alias for QWEN_CODEX_CONTEXT_WINDOW.
# QWEN_MAX_MODEL_LEN=32768

# Legacy alias for QWEN_CODEX_YOLO_REFINER_BASE_URL.
# YOLO_REFINER_BASE_URL=http://127.0.0.1:8002/v1

# Legacy alias for QWEN_CODEX_YOLO_REFINER_API_KEY.
# YOLO_REFINER_API_KEY=local-dev-key

# Legacy alias for QWEN_CODEX_YOLO_REFINER_MODEL.
# YOLO_REFINER_MODEL=qwen35-local

# Legacy alias for QWEN_CODEX_YOLO_LOG_DIR.
# YOLO_LOG_DIR=.qwen-codex/yolo-runs

# Legacy alias for QWEN_CODEX_YOLO_DEFAULT_ITERATIONS.
# YOLO_DEFAULT_ITERATIONS=

# Hugging Face token for model download rate limits. Leave blank for public unauthenticated pulls.
HF_TOKEN=

# Host port exposed by the vLLM Docker Compose file.
QWEN_VLLM_HOST_PORT=8002

# Hugging Face model repository served by vLLM.
VLLM_MODEL_REPO=QuantTrio/Qwen3.5-9B-AWQ

# Served model name passed to vLLM.
VLLM_SERVED_MODEL_NAME=qwen35-local

# vLLM max model length.
VLLM_MAX_MODEL_LEN=32768

# vLLM GPU memory utilization target.
VLLM_GPU_MEMORY_UTILIZATION=0.90

# vLLM attention backend for text attention.
VLLM_ATTENTION_BACKEND=TRITON_ATTN

# vLLM attention backend for multimodal encoder attention.
VLLM_MM_ENCODER_ATTN_BACKEND=TRITON_ATTN

# vLLM tool-call parser. `qwen3_coder` is the default for this template; `qwen3_xml`
# is another Qwen parser option to test when changing model families or vLLM versions.
VLLM_TOOL_CALL_PARSER=qwen3_coder

# vLLM quantization mode for the AWQ model.
VLLM_QUANTIZATION=awq

# vLLM maximum batched tokens.
VLLM_MAX_BATCHED_TOKENS=1024
